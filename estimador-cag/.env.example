# Copia este archivo como .env y rellena tus valores. El .env nunca entra en git.
# Una variable vacía usa el valor por defecto de app/config.py.

# --- Proveedor del LLM ---
# Solo es obligatoria la API key del proveedor elegido en LLM_PROVIDER.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# openai o anthropic (por defecto: anthropic)
LLM_PROVIDER=
# Modelo del proveedor (por defecto: claude-haiku-5-5)
LLM_MODEL=

# --- Aplicación ---
# development, staging o production (por defecto: development)
APP_ENV=
# DEBUG, INFO, WARNING o ERROR (por defecto: DEBUG)
LOG_LEVEL=
